BEGIN                                                                   00001000          
  COMMENT A simple Unisys (Burroughs) Extended ALGOL program;           00002000          
                                                                        00003000          
  INTEGER I, FACT;                                                      00004000          
                                                                        00005000          
  FACT := 1;                                                            00006000          
  FOR I := 1 STEP 1 UNTIL 5 DO                                          00007000          
    FACT := FACT * I;                                                   00008000          
                                                                        00009000          
  DISPLAY("FACTORIAL OF 5 = " CAT STRING(FACT, *));                     00010000          
END.                                                                    00011000          
